# Copy to server/.env and fill in real values. DO NOT COMMIT .env.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ecoleos

# Port the API listens on
PORT=4000

# JWT signing secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_48_random_bytes_hex
JWT_REFRESH_SECRET=replace_with_another_48_random_bytes_hex

# Super admin credentials (server-side only)
SUPER_USER=superadmin
SUPER_PASS=replace_with_a_strong_unique_password

# Secret used to sign/verify ÉcoleOS license keys.
# CRITICAL: this ONE value must be identical in three places or keys won't validate:
#   1. VITE_LICENSE_CHECK_KEY in the frontend build (Vercel env) — the browser verifies with it
#   2. the env you run generate-license.js with (it reads VITE_LICENSE_CHECK_KEY)
#   3. this server verify route (reads VITE_LICENSE_CHECK_KEY, falls back to ECOLEOS_LICENSE_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_LICENSE_CHECK_KEY=replace_with_the_same_value_used_in_the_vercel_build
# Legacy name, still honored as a fallback if VITE_LICENSE_CHECK_KEY is unset:
ECOLEOS_LICENSE_SECRET=replace_with_48_random_bytes_hex

# Comma-separated list of origins allowed to call the API from the browser.
# Example: https://app.ecoleos.com,https://admin.ecoleos.com
CORS_ORIGINS=http://localhost:5173
